# For local-only production testing. Do not enable this on a public deployment.
ACADEMY_LOCAL_DEMO=true
# Required for private production hosting. Choose a long unique password.
ACADEMY_ACCESS_PASSWORD=
# Optional live AI. Configure both on the server; never use NEXT_PUBLIC_ for these.
AI_GATEWAY_API_KEY=
AI_MODEL=
# Optional Supabase cross-device progress. Only the publishable key goes to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
